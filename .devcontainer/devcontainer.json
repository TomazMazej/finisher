{
  "name": "Finisher",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
  "hostRequirements": { "cpus": 2 },
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": { "label": "Finisher (astro dev)", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "npm install --legacy-peer-deps && npm run db:migrate:local -w @finisher/web",
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "svelte.svelte-vscode",
        "vitest.explorer",
        "anthropic.claude-code"
      ]
    }
  }
}
